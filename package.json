{
  "name": "aion2-tracker",
  "private": true,
  "version": "0.7.0",
  "description": "Local Aion 2 character sheet. Public profiles supply gear, skills, and Daevanion. Dailies, goals, and the Odyle clock stay on this device.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "dist:windows": "npm run build && electron-builder --win nsis --x64"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eiruuru/aion2-char-sheet.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "build": {
    "appId": "local.aion2.progress",
    "productName": "Aion 2 Progress",
    "executableName": "Aion2Progress",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "electron/START.txt",
        "to": "START.txt"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "electron/after-pack.cjs",
    "releaseInfo": {
      "releaseNotes": "Pet progress sits beside Odyle: level, souls, and souls to the next level. Optional Live Sync on Windows can fill those from your own game traffic after Npcap is installed. Manual entry still works."
    },
    "publish": {
      "provider": "github",
      "owner": "eiruuru",
      "repo": "aion2-char-sheet",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
