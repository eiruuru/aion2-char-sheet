{
  "name": "aion2-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Local Aion 2 roster tracker. It shows today's tasks, gear, skills, and Daevanion boards, and keeps Odyle and bank readings on their own clocks.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "dist:windows": "npm run build && electron-builder --win zip --x64 && node electron/copy-download.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "build": {
    "appId": "local.aion2.progress",
    "productName": "Aion 2 Progress",
    "executableName": "Aion2Progress",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "electron/START.txt",
        "to": "START.txt"
      }
    ],
    "asar": true,
    "electronLanguages": ["en-US"],
    "afterPack": "electron/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
